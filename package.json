{
  "name": "question-bank",
  "productName": "知识题库",
  "version": "0.1.0",
  "private": true,
  "description": "知识题库桌面应用:看题模式与背题模式,离线使用",
  "author": "Hongyu3273",
  "homepage": "https://github.com/Hongyu3273/question-bank",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "node scripts/ensure-electron.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "read-excel-file": "^9.3.20",
    "sql.js": "^1.17.0",
    "ts-fsrs": "^6.0.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource/inter": "^5.2.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@uiw/react-codemirror": "^4.25.13",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "i18next": "^27.2.7",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.7",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
